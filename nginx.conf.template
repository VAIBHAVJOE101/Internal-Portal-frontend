# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# ${BACKEND_URL} is the backend Service, by default http://devops-portal-backend:8080 (same namespace).

# Keep the scheme/host the browser used (set by the ingress controller) so backend redirects and OAuth callbacks are correct
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}
map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ''      $http_host;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # hashed build assets can be cached forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Backend API, OAuth, actuator and Swagger, proxied to the backend Service inside the cluster
    location /devopsportal/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # the server block already adds these
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        client_max_body_size 10m;
        # keep the alert SSE stream (/devopsportal/api/alerts/stream) open and unbuffered
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    # SPA fallback; index.html must never be cached so new releases are picked up
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
